# Copy this file to .env.deploy on the deployment host and restrict it to the deployment user (chmod 600).
# Replace every placeholder before starting Compose. Never commit .env.deploy.
PUBLIC_ORIGIN=https://your-staging-domain.example
PUBLIC_BIND=127.0.0.1
HTTPS_PORT=8443

POSTGRES_DB=neuroforge
POSTGRES_USER=neuroforge_app
# Generate a long random hex password (e.g. openssl rand -hex 32) and use the same value below.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
# Password must be URL-encoded if it contains reserved URL characters; a hex value needs no encoding.
DATABASE_URL=postgresql+psycopg://neuroforge_app:REPLACE_WITH_RANDOM_HEX_PASSWORD@db:5432/neuroforge

# Add server-side provider keys only when you are ready to authorize/cost-control live requests.
LLM_API_KEY=
TAVILY_API_KEY=
