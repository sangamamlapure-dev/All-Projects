# JalDrishti Environment Configuration Template
# For Smart India Hackathon 2026 Presentation / Deployment

# Demo Mode Flag (defaults to true for standalone operation without hardware)
VITE_DEMO_MODE=true

# Future Firebase Integration Credentials
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Future Backend Node.js / Express API Endpoint
VITE_API_BASE_URL=https://api.jaldrishti.gov.in/v1

# MQTT Telemetry Broker (ESP32 Gateway)
VITE_MQTT_BROKER_URL=wss://mqtt.jaldrishti.gov.in:8884
